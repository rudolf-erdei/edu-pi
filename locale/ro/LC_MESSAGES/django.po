msgstr "Sigur doriți să resetați aceste setări la valorile implicite?"

msgid "General Settings"
msgstr "Setări generale"

msgid "Reset to Defaults"
msgstr "Resetează la valorile implicite"

msgid "Save Settings"
msgstr "Salvează setările"

msgid "School Logo"
msgstr "Logo școală"

