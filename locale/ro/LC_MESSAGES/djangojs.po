# JS strings (static/js/update.js) - djangojs domain
# Update stage labels
msgid "Check git repository"
msgstr "Verifică repository-ul git"

msgid "Stop service"
msgstr "Oprește serviciul"

msgid "Pull latest changes"
msgstr "Descarcă ultimele modificări"

msgid "Update dependencies"
msgstr "Actualizează dependențele"

msgid "Run migrations"
msgstr "Rulează migrările"

msgid "Collect static files"
