# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Database
#
# The live database is written by the running app and is deliberately NOT
# tracked: if it were, every update would stash it, the merge would replace it
# with the committed copy, and the teacher's data would be gone. Ship initial
# data as a fixture/migration instead.
#
# The `.update-tmp-*` pattern is the name update.sh / update-web.sh give the
# file while they move it out of the working tree for the duration of the pull.
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm
db.sqlite3.update-tmp-*

# Uploaded files are written by the running app, and are deliberately NOT
# tracked for the same reason: the school's logo is uploaded from the settings
# page, so any commit of it is a placeholder, and every update used to stash the
# teacher's upload and merge the placeholder back over it — the logo appeared to
# vanish. Nothing under media/ belongs in git.
#
# The `.update-tmp-*` pattern is the name update.sh / update-web.sh give a file
# while they move it out of the working tree for the duration of the pull.
media/
*.sqlite3
entities.json
mempalace.yaml
/docs/superpowers/
/.serena/
/.claude/
/.vscode/
.claude/settings.local.json
ISSUES.md
CLAUDE.md
